# Copie ce fichier en .env et remplis les valeurs. Le fichier .env n'est jamais commité.
#
# Les variables EXPO_PUBLIC_ sont lisibles en clair dans l'app compilée.
# N'y mets jamais de clé secrète (clé « secret » Supabase, mot de passe de base de données).

# Supabase : URL du projet et clé « publishable » (commence par sb_publishable_)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat : clés publiques des apps iOS et Android
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
